field_metadata:
  "source.id":
    field_label: Source
    field_description: The data source of the document.
    field_name: source.id
    field_data_type: keyword
    support_multi_select: true
    field_icon: database

  category:
    field_label: Category
    field_description: Primary category of the document, e.g., report.
    field_name: category
    field_data_type: keyword
    support_multi_select: true
    field_icon: folder

  subcategory:
    field_label: Subcategory
    field_description: Secondary category of the document, e.g., 2024.
    field_name: subcategory
    field_data_type: keyword
    support_multi_select: true
    field_icon: folder

  categories:
    field_label: Categories
    field_description: List of categories the document belongs to.
    field_name: categories
    field_data_type: keyword
    support_multi_select: true
    field_icon: folder

  title:
    field_label: Title
    field_description: Title of the document.
    field_name: title
    field_data_type: text
    support_multi_select: false
    field_icon: heading-1

  type:
    field_label: Type
    field_description: Type of the document, e.g., PDF.
    field_name: type
    field_data_type: keyword
    support_multi_select: false
    field_icon: case-sensitive

  lang:
    field_label: Lang
    field_description: Language of the document.
    field_name: lang
    field_data_type: keyword
    support_multi_select: false
    field_icon: case-sensitive

  content:
    field_label: Content
    field_description: The main content or body of the document.
    field_name: content
    field_data_type: text
    support_multi_select: false
    field_icon: text

  icon:
    field_label: Icon
    field_description: URL to the documents icon.
    field_name: icon
    field_data_type: url
    support_multi_select: false
    field_icon: link

  size:
    field_label: Size
    field_description: Size of the document in bytes.
    field_name: size
    field_data_type: integer
    support_multi_select: false
    field_icon: number

  "owner.avatar":
    field_label: Owner Avatar
    field_description: URL to the owners avatar image.
    field_name: owner.avatar
    field_data_type: url
    support_multi_select: false
    field_icon: link

  "owner.username":
    field_label: Owner Username
    field_description: Username of the owner.
    field_name: owner.username
    field_data_type: keyword
    support_multi_select: false
    field_icon: case-sensitive

  "owner.userid":
    field_label: Owner Userid
    field_description: User ID of the owner.
    field_name: owner.userid
    field_data_type: keyword
    support_multi_select: false
    field_icon: case-sensitive

  "last_updated_by.user.avatar":
    field_label: Last Updated By User Avatar
    field_description: URL to the avatar of the last editor.
    field_name: last_updated_by.user.avatar
    field_data_type: url
    support_multi_select: false
    field_icon: link

  "last_updated_by.user.username":
    field_label: Last Updated By User Username
    field_description: Username of the last editor.
    field_name: last_updated_by.user.username
    field_data_type: keyword
    support_multi_select: false
    field_icon: case-sensitive

  "last_updated_by.user.userid":
    field_label: Last Updated By User Userid
    field_description: User ID of the last editor.
    field_name: last_updated_by.user.userid
    field_data_type: keyword
    support_multi_select: false
    field_icon: case-sensitive

  "last_updated_by.timestamp":
    field_label: Last Updated Timestamp
    field_description: Timestamp of the last update.
    field_name: last_updated_by.timestamp
    field_data_type: datetime
    support_multi_select: false
    field_icon: calendar

  attachments:
    field_label: Attachments
    field_description: Related attachments, storing document IDs in the coco_attachment-v2 index.
    field_name: attachments
    field_data_type: keyword
    support_multi_select: true
    field_icon: folder

  "metadata.content_category":
    field_label: Content Category
    field_description: >-
      High-level content category, more granular than metadata.mime_type. Enum
      values: doc, image, video, music, webpage.
    field_name: metadata.content_category
    field_data_type: keyword
    support_multi_select: false
    field_icon: folder

  "metadata.content_type":
    field_label: Content Type
    field_description: >-
      Detailed content type, more granular than metadata.mime_type. Enum values:
      image, video, markdown, pdf, docx, pptx, xlsx.
    field_name: metadata.content_type
    field_data_type: keyword
    support_multi_select: false
    field_icon: folder

  "metadata.mime_type":
    field_label: MIME Type
    field_description: >-
      Document MIME type, used to determine preview/view component and search
      result rendering.
    field_name: metadata.mime_type
    field_data_type: keyword
    support_multi_select: false
    field_icon: folder

  "metadata.colors":
    field_label: Colors
    field_description: >-
      Primary colors extracted from images.
    field_name: metadata.colors
    field_data_type: keyword
    support_multi_select: true
    field_icon: folder

  "metadata.width":
    field_label: Width
    field_description: Original width of the image or video in pixels.
    field_name: metadata.width
    field_data_type: integer
    support_multi_select: false
    field_icon: folder

  "metadata.height":
    field_label: Height
    field_description: Original height of the image or video in pixels.
    field_name: metadata.height
    field_data_type: integer
    support_multi_select: false
    field_icon: folder

  "metadata.users":
    field_label: Users
    field_description: User list for filtering.
    field_name: metadata.users
    field_data_type: object
    support_multi_select: true
    field_icon: folder

  tags:
    field_label: Tags
    field_description: Tags associated with the document.
    field_name: tags
    field_data_type: keyword
    support_multi_select: true
    field_icon: tag

  cover:
    field_label: Cover
    field_description: Cover image URL used for document presentation.
    field_name: cover
    field_data_type: url
    support_multi_select: false
    field_icon: folder

  thumbnail:
    field_label: Thumbnail
    field_description: Thumbnail image URL used in image search results.
    field_name: thumbnail
    field_data_type: url
    support_multi_select: false
    field_icon: link

  url:
    field_label: URL
    field_description: URL for document preview or direct access.
    field_name: url
    field_data_type: url
    support_multi_select: false
    field_icon: link

  "ai_insights.text":
    field_label: AI Insights
    field_description: AI-generated insights in markdown format.
    field_name: ai_insights.text
    field_data_type: text
    support_multi_select: false
    field_icon: folder

  summary:
    field_label: Summary
    field_description: Short plain-text summary in English.
    field_name: summary
    field_data_type: text
    support_multi_select: false
    field_icon: book-open-text

